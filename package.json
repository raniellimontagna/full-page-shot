{
  "name": "full-page-shot",
  "version": "0.1.0",
  "description": "Capture the entire scrollable page in one click.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "VITE_FPS_E2E=1 vite build --outDir dist-e2e --emptyOutDir",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test:e2e": "pnpm build:e2e && playwright test",
    "lint": "oxlint src tests e2e"
  },
  "license": "ISC",
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/chrome": "0.2.7",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "oxlint": "^1.81.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
