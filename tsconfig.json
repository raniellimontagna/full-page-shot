{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    // `@crxjs/vite-plugin/client` declares the `*?script&iife` module used by
    // the background service worker to pull in the bundled content script.
    "types": ["chrome", "vite/client", "@crxjs/vite-plugin/client"],
    "jsx": "react-jsx"
  },
  "include": ["src", "tests", "vite.config.ts"]
}
